{
  "name": "video-to-notes",
  "version": "0.1.0",
  "description": "Video-to-Notes - MP4 video analysis with frame extraction, OCR, transcription, scene detection, timestamp alignment, and structured note generation",
  "main": "dist/plugin/index.js",
  "types": "dist/plugin/index.d.ts",
  "cordis": {
    "name": "video-to-notes",
    "inject": ["tools"],
    "config": {
      "ffmpegPath": "ffmpeg",
      "ffprobePath": "ffprobe",
      "tesseractPath": "tesseract",
      "whisperPath": "whisper-cli",
      "whisperModelDir": "./models",
      "outputDir": "./notes",
      "maxConcurrent": 2,
      "logLevel": "info",
      "configPath": ""
    }
  },
  "scripts": {
    "build": "tsc",
    "build:plugin": "tsc -p tsconfig.plugin.json"
  }
}