{
  "name": "video-to-notes",
  "version": "0.1.0",
  "description": "Transform video content into structured, searchable Markdown notes with timestamps, citations, and grounded summaries",
  "type": "module",
  "main": "dist/plugin/index.js",
  "types": "dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./lib": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "vtn": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist dist-plugin",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fix:curated-images": "node scripts/fix-curated-images.mjs",
    "vtn": "node dist/cli.js",
    "server": "node dist/interfaces/rest/server.js",
    "dev": "node --watch src/cli.ts"
  },
  "keywords": [
    "video",
    "notes",
    "transcription",
    "ocr",
    "markdown",
    "summarization",
    "llm",
    "deepseek",
    "harness"
  ],
  "author": "rpmalukani22",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rpmalukani22/video-to-notes.git"
  },
  "bugs": {
    "url": "https://github.com/rpmalukani22/video-to-notes/issues"
  },
  "homepage": "https://github.com/rpmalukani22/video-to-notes#readme",
  "engines": {
    "node": ">=20.0.0",
    "dsh": "^0.2.2-rc.1"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "fast-glob": "^3.3.3",
    "sharp": "^0.35.5",
    "undici": "^8.12.4",
    "yaml": "^2.3.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.10.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "volta": {
    "node": "20.10.0"
  },
  "dsh": {
    "bundle": {
      "name": "video-to-notes",
      "main": "dist/plugin/index.js",
      "types": "dist/plugin/index.d.ts",
      "patch": "dsh.bundle.patch.yml",
      "cordis": {
        "name": "video-to-notes",
        "inject": [
          "tools"
        ],
        "config": {
          "ffmpegPath": "ffmpeg",
          "ffprobePath": "ffprobe",
          "tesseractPath": "tesseract",
          "whisperPath": "whisper-cli",
          "whisperModelDir": "./models",
          "outputDir": "./notes",
          "maxConcurrent": 2,
          "logLevel": "info",
          "configPath": ""
        }
      }
    }
  }
}
